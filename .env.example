# EDUONE Environment Variables Configuration Template
# Copy this to .env.local for local testing, or add these in Vercel Project Settings > Environment Variables.

# Public site canonical URL (replace with your custom domain once connected)
NEXT_PUBLIC_SITE_URL=https://your-custom-domain.com

# (Optional) Institutional Notification via Resend (https://resend.com)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# NOTIFICATION_EMAIL=enquiry@your-domain.com

# (Optional) Forward enquiries to Slack, Discord, Zapier or Google Sheets webhook
# ENQUIRY_WEBHOOK_URL=https://hooks.slack.com/services/...
